# Copy to .env (Bun loads it automatically on `bun run`)
PORT=4317
HOST=127.0.0.1

# 32 byte random, base64. Generate: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
NSIC_MASTER_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com


# System binary paths (leave empty to auto-detect on PATH)
CHROME_PATH=
FFMPEG_PATH=
SUITECLOUD_PATH=

DATA_DIR=./data
LOG_LEVEL=info
